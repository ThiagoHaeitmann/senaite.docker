[buildout]
index = https://pypi.org/simple/
extends = https://dist.plone.org/release/5.2-latest/versions.cfg
find-links =
    https://dist.plone.org/release/5.2-latest/
    https://dist.plone.org/thirdparty/

parts =
    instance
    zeoserver
    backup

eggs =
    senaite.core
    senaite.lims
    senaite.databox
    senaite.storage
    senaite.patient
    senaite.ldap
    senaite.jsonapi
    senaite.impress
    senaite.app.supermodel
    senaite.app.spotlight
    senaite.app.listing
    senaite.ast
    senaite.abx
    senaite.microorganism
    senaite.panic
    plone.restapi
    plone.session
    Products.GenericSetup
    collective.saml2
    pas.plugins.headers
    dm.zope.saml2
    dm.saml2

auto-checkout = *
eggs-directory = /app/eggs
download-cache = /app/downloads
extensions = mr.developer
versions = versions
show-picked-versions = true
plone-user = admin:Labpharma@0012
sources = sources

[sources]
senaite.core = git https://github.com/senaite/senaite.core.git branch=2.x
senaite.app.listing = git https://github.com/senaite/senaite.app.listing.git branch=2.x
senaite.app.spotlight = git https://github.com/senaite/senaite.app.spotlight.git branch=2.x
senaite.app.supermodel = git https://github.com/senaite/senaite.app.supermodel.git branch=2.x
senaite.databox = git https://github.com/senaite/senaite.databox.git branch=master
senaite.impress = git https://github.com/senaite/senaite.impress.git branch=2.x
senaite.jsonapi = git https://github.com/senaite/senaite.jsonapi.git  branch=2.x
senaite.lims = git https://github.com/senaite/senaite.lims.git branch=2.x
senaite.storage = git https://github.com/senaite/senaite.storage.git branch=2.x
senaite.patient = git https://github.com/senaite/senaite.patient.git branch=master
senaite.ldap = git https://github.com/senaite/senaite.ldap.git branch=master
senaite.ast = git https://github.com/senaite/senaite.ast.git branch=master
senaite.abx = git https://github.com/senaite/senaite.abx.git branch=master
senaite.microorganism = git https://github.com/senaite/senaite.microorganism.git branch=master
senaite.panic = git https://github.com/senaite/senaite.panic.git branch=2.x

[zeoserver]
recipe = plone.recipe.zeoserver
zeo-address = 0.0.0.0:8100
file-storage = /data/zeo/Data.fs
blob-storage = /data/blob/blobstorage
pack-days = 7

var = /data/var
pid-file = /data/var/zeoserver.pid
zeo-log = /data/var/log/zeoserver.log

[instance]
recipe = plone.recipe.zope2instance
http-address = 0.0.0.0:8080
user = admin:Labpharma@0012
wsgi = on

event-log-handler = StreamHandler
event-log-args = (sys.stderr,)
access-log-handler = StreamHandler
access-log-args = (sys.stdout,)

zeo-client = on
zeo-address = 127.0.0.1:8100
shared-blob = on
blob-storage = /data/blob/blobstorage

var = /data/var

eggs =
    Plone
    plone.app.upgrade
    ${buildout:eggs}

deprecation-warnings = off
environment-vars =
    TZ America/Sao_Paulo

[backup]
recipe = collective.recipe.backup
location = /data/backups/filestorage
blobbackuplocation = /data/backups/blobstorage
keep = 5
gzip = true

[versions]
senaite.core = 2.6.0
et-xmlfile = 1.1.0
openpyxl = 2.6.4
magnitude = 1.0.1
Werkzeug = 1.0.1
cairocffi = 0.9.0
collective.recipe.plonesite = 1.12.0
cssselect2 = 0.2.2
more-itertools = 5.0.0
node.ext.ugm = 1.1
pdfrw = 0.4
plumber = 1.7
tinycss2 = 0.6.1
unittest2 = 1.1.0
Products.DataGridField = 1.9.6
argparse = 1.4.0
dicttoxml = 1.7.16
jdcal = 1.4.1
linecache2 = 1.0.0
plone.jsonapi.core = 0.7.0
senaite.api = 1.2.3.post2
traceback2 = 1.4.0
xlrd = 2.0.2
plone.restapi = 7.9.1
BTree = 4.11.3
PyXB = 1.2.3
dm.zope.saml2 = 5.0.1
dm.saml2 = 3.2.3
dm.xmlsec.binding = 2.2
collective.recipe.backup = 4.2.0
collective.saml2 = 1.5
dm.reuse = 2.2
dm.zope.schema = 4.0.1
